		{
			"id": "uk-postcode",
			"name": "UK postcode",
			"variants": [
				{
					"id": "default",
					"naxp": "\\A\\A?\\9\\X? \\s!! \\9\\A\\A | GIR \\s!! 0AA",
					"maxEncodedValue": "1755842401",
					"notes": "*Accepts* a postcode with or without a separator space, e.g. `B1 1AA` or `B11AA`.\n*Prints* **with** a space, e.g. `B1 1AA`.",
					"valid": [
						{ "text": "EC4M 8AD", "value": "278794572", "canonical": "EC4M 8AD" },
						{ "text": "B1 1AA", "value": "67783197", "canonical": "B1 1AA" },
						{ "text": "GIR 0AA", "value": "1755842401", "canonical": "GIR 0AA" },
						{ "text": "SW1A 1AA", "value": "1205903557", "canonical": "SW1A 1AA" },
						{ "text": "EC4M8AD", "value": "278794572", "canonical": "EC4M 8AD" },
						{ "text": "B11AA", "value": "67783197", "canonical": "B1 1AA" },
						{ "text": "GIR0AA", "value": "1755842401", "canonical": "GIR 0AA" }
					],
					"invalid": [ "B1   1AA", "B1  1AA", "GIR   0AA", "b1 1aa", "B1 1A", "1B 1AA", "EC4M  8AD", "B1-1AA", "" ]
				},
				{
					"id": "padding-tolerant",
					"naxp": "(\\A\\A\\9\\X|\\A\\A\\9\\s!?|\\A\\9\\X\\s!?|\\A\\9\\s!?\\s!?) \\s!! \\9\\A\\A | GIR \\s!?\\s!?\\s!! 0AA",
					"maxEncodedValue": "1755842401",
					"notes": "*Accepts* padding of spaces up to eight characters, e.g. `B1   1AA`, `B1 1AA` or `B11AA`.\n*Prints* as standard, i.e. with a single space, e.g. `B1 1AA`.",
					"valid": [
						{ "text": "EC4M 8AD", "value": "278794572", "canonical": "EC4M 8AD" },
						{ "text": "B1 1AA", "value": "67783197", "canonical": "B1 1AA" },
						{ "text": "B1   1AA", "value": "67783197", "canonical": "B1 1AA" },
						{ "text": "B1  1AA", "value": "67783197", "canonical": "B1 1AA" },
						{ "text": "B11AA", "value": "67783197", "canonical": "B1 1AA" },
						{ "text": "GIR   0AA", "value": "1755842401", "canonical": "GIR 0AA" },
						{ "text": "GIR0AA", "value": "1755842401", "canonical": "GIR 0AA" }
					],
					"invalid": [ "b1 1aa", "B1 1A", "1B 1AA", "EC4M  8AD", "B1-1AA", "" ]
				},
				{
					"id": "padding-canonical",
					"naxp": "(\\A\\A\\9\\X|\\A\\A\\9\\s!!|\\A\\9\\X\\s!!|\\A\\9\\s!!\\s!!) \\s!! \\9\\A\\A | GIR \\s!!\\s!!\\s!! 0AA",
					"maxEncodedValue": "1755842401",
					"notes": "*Accepts* padding of spaces up to eight characters, e.g. `B1   1AA`, `B1 1AA` or `B11AA`.\n*Prints* the padded version, e.g. `B1   1AA`. (Useful for writing *to* IT systems.)",
					"valid": [
						{ "text": "EC4M 8AD", "value": "278794572", "canonical": "EC4M 8AD" },
						{ "text": "B1 1AA", "value": "67783197", "canonical": "B1   1AA" },
						{ "text": "B1   1AA", "value": "67783197", "canonical": "B1   1AA" },
						{ "text": "B11AA", "value": "67783197", "canonical": "B1   1AA" },
						{ "text": "GIR 0AA", "value": "1755842401", "canonical": "GIR   0AA" },
						{ "text": "GIR0AA", "value": "1755842401", "canonical": "GIR   0AA" }
					],
					"invalid": [ "b1 1aa", "B1 1A", "1B 1AA", "EC4M  8AD", "B1-1AA", "" ]
				}
			]
		},
