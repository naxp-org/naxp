		{
			"id": "nl-postcode",
			"name": "Netherlands postcode",
			"variants": [
				{
					"id": "default",
					"naxp": "\\9\\9\\9\\9 \\s!! \\A\\A",
					"maxEncodedValue": "6760000",
					"notes": "*Accepts* a postcode with or without a separator space, e.g. `1012 AB` or `1012AB`.\n*Prints* **with** a space, e.g. `1012 AB`.",
					"valid": [
						{ "text": "1012 AB", "value": "684114", "canonical": "1012 AB" },
						{ "text": "9999 ZZ", "value": "6760000", "canonical": "9999 ZZ" },
						{ "text": "0999 ZZ", "value": "676000", "canonical": "0999 ZZ" },
						{ "text": "1012AB", "value": "684114", "canonical": "1012 AB" }
					],
					"invalid": [ "1012-AB", "1012  AB", "101 AB", "1012 A1", "1012 ab" ]
				},
				{
					"id": "no-separator",
					"naxp": "\\9\\9\\9\\9 \\s!? \\A\\A",
					"maxEncodedValue": "6760000",
					"notes": "*Accepts* a postcode with or without a separator space, e.g. `1012 AB` or `1012AB`.\n*Prints* **without** a space, e.g. `1012AB`. (Useful for writing *to* IT systems.)",
					"valid": [
						{ "text": "1012 AB", "value": "684114", "canonical": "1012AB" },
						{ "text": "1012AB", "value": "684114", "canonical": "1012AB" }
					],
					"invalid": [ "1012-AB", "1012  AB", "101 AB", "1012 A1", "1012 ab" ]
				},
				{
					"id": "hyphen-tolerant",
					"naxp": "\\9\\9\\9\\9 (\\s|\\-)?!(\\s) \\A\\A",
					"maxEncodedValue": "6760000",
					"notes": "*Accepts* a postcode with or without a separator space, or with a hyphen as a separator, e.g. `1012 AB`, `1012-AB` or `1012AB`.\n*Prints* **with** a space, e.g. `1012 AB`.",
					"valid": [
						{ "text": "1012 AB", "value": "684114", "canonical": "1012 AB" },
						{ "text": "1012-AB", "value": "684114", "canonical": "1012 AB" },
						{ "text": "1012AB", "value": "684114", "canonical": "1012 AB" }
					],
					"invalid": [ "1012  AB", "101 AB", "1012 A1", "1012 ab" ]
				}
			]
		},
		{
			"id": "flight-designator",
			"name": "Flight designator",
