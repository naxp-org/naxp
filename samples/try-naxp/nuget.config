<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<!--
		The only source is the folder `dotnet pack` writes to, three levels up. A NuGet feed can be
		an ordinary directory; nothing has to be hosted. The path is relative to this file, so it
		works from any clone.

		<clear /> matters: without it NuGet also asks nuget.org, where the naxp id is reserved but
		unpublished, and the restore fails in a way that looks like a packing problem.
		-->
		<clear />
		<add key="naxp-local" value="..\..\artifacts\packages" />
	</packageSources>
</configuration>
