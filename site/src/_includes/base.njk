<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description or 'naxp maps ASCII codes to a numerical index unambiguously and safely across coding languages and hardware platforms.' }}">
<link rel="icon" href="/img/naxp-icon-solid-white.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/naxp.css">
<script>
// Both before the first paint: a pinned theme, so it never flashes the other
// one, and the marker that reveals the button that sets it.
document.documentElement.classList.add('js');
try {
  var t = localStorage.getItem('naxp-theme');
  if (t === 'light' || t === 'dark') { document.documentElement.dataset.theme = t; }
} catch (e) {}
</script>
<script src="/js/theme.js" defer></script>
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:image" content="https://naxp.org/img/naxp-social-card-1280x640.png">
<meta name="twitter:card" content="summary_large_image">
</head>
<body>

<!-- siteheader -->

<main>
{{ content | safe }}
</main>

<!-- sitefooter -->

</body>
</html>
