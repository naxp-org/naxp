# The C# solution has its own root .editorconfig at src/cs. This one covers the JavaScript
# package, and is deliberately separate: the two languages agree on tabs and on line endings and
# on nothing else.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{json,md}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
