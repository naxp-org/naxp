{
	"name": "@naxp/naxp",
	"version": "0.11.0",
	"description": "A naxp ('encoded ASCII expression') uses a regex-like syntax to define how ASCII strings should be mapped to a numerical index.",
	"keywords": [
		"naxp",
		"encoding",
		"ascii",
		"identifier",
		"postcode"
	],
	"homepage": "https://naxp.org",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/naxp-org/naxp.git",
		"directory": "src/js"
	},
	"bugs": {
		"url": "https://github.com/naxp-org/naxp/issues"
	},
	"license": "Apache-2.0",
	"author": "Tim Gordon",
	"type": "module",
	"types": "./types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"files": [
		"lib",
		"types",
		"LICENSE",
		"NOTICE",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"test": "node --test",
		"types": "tsc -p tsconfig.json",
		"prepack": "npm run types && npm test"
	}
}
